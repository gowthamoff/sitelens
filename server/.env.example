# Server Environment Variables Example

# Database Selection
# Set to 'local' for local Docker (port 5432)
# Set to 'rds' for AWS RDS via SSM Tunnel (port 5400)
DB_TARGET=local

# Local DB Config
PG_HOST=localhost
PG_PORT=5432
PG_DB=your_local_db_name
PG_USER=your_local_db_user
PG_PASS=your_local_db_password

# RDS Config (Used when DB_TARGET=rds)
RDS_HOST=your_rds_endpoint
RDS_PORT=5432
RDS_DB=your_production_db_name
RDS_USER=your_production_user
RDS_PASS=your_production_password

# Optional: External Tile Server (Martin)
# If set, the server can proxy /tiles to this URL
TILE_SERVER_URL=http://localhost:3000

# Google Places API (New) — Competitor Enrichment
# Get your key from: https://console.cloud.google.com/apis/credentials
# Ensure "Places API (New)" is enabled in your project.
# Leave blank to disable Google enrichment (OSM-only mode).
GOOGLE_PLACES_KEY=your_google_places_api_key

# ─── AWS Deployment Configurations ──────────────────────
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=your_aws_account_id
ECR_REPO_BACKEND=your_account_id.dkr.ecr.ap-south-1.amazonaws.com/site-analysis
ECR_REPO_NDVI=your_account_id.dkr.ecr.ap-south-1.amazonaws.com/site-analysis/ndvi-service
CF_STACK_NAME=site-analysis-bend
